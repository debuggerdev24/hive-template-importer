# -----------------------------------------------------------------------------
# Hive Inspect — Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For production deployment (e.g. Vercel):
#   Add these variables in your Vercel Project Settings > Environment Variables.
# -----------------------------------------------------------------------------

# 1. Supabase Client Configuration (Public)
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 2. Supabase Server Configuration (Secret - Server Only)
# Optional: Service role key for administrative server actions (bypass RLS if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-server-actions

# 3. Direct PostgreSQL Connection URI (Secret - Server Only)
# Used by:
#   - CLI migration runner: `npm run db:migrate`
#   - Atomic batch-update endpoint (`/api/templates/[id]/batch-update`) for ACID transactions via 'pg'
# Found in: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Recommended: Use the connection pooler URL on port 6543
DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres
